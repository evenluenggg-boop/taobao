# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments and local Python versions
.venv/
venv/
env/
ENV/
.python-version

# Local environment variables and secrets
.env
.env.*
!.env.example

# Local Taobao business data; keep directory placeholders only
data/raw/*
data/processed/*
data/exports/*
data/local/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep
!data/local/.gitkeep
!data/templates/
!data/templates/**

# Runtime logs
logs/*
!logs/.gitkeep
*.log

# Local databases and generated reports
db.sqlite3
db.sqlite3-journal
*.sqlite
*.sqlite3
*.db
*.csv
*.xlsx
*.xls
*.jsonl
!data/templates/*.csv

# Tooling and editor state
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
